<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pull in module-level test sources that live under core/gameplay/<module>/tests/ -->
    <Compile Include="../*/tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Core.Gameplay.csproj" />
    <ProjectReference Include="../../../adapters/stub/Adapters.Stub.csproj" />
    <!-- T-N6-1（ADR-0035 决策 1）：GameWorldFixture.Build 已把"组装一整套世界"的逻辑上提到
         core/sim（Core.Sim.HeadlessWorldBuilder），本工程需要这条引用才能编译 EndToEnd 测试
         夹具；Core.Sim 是生产代码（非 Tests.*），引用方向与 CORE114-04 那条 Presentation.Common
         引用同理——只影响 Tests.Gameplay，不改变生产装配的层次依赖方向。 -->
    <ProjectReference Include="../../sim/Core.Sim.csproj" />
    <!-- CORE114-04 根治（外部审计 audit-76d16a5-20260910）：验收要求覆盖正式装配
         Presentation.Assembly.ContentValidationAssembly.Run 默认参数下 quest.def/dialog.gossip_menu
         对非法 {"$id":...} 的端到端行为（见 core/gameplay/quest/tests/CORE114_04_*、
         core/gameplay/dialog/tests/CORE114_04_* 判断记录）——Core.Gameplay（生产代码）不依赖
         presentation/，只有测试需要引用它，新增这条引用只影响 Tests.Gameplay，不影响生产装配的层次
         依赖方向（presentation → core/gameplay，反向不成立）。 -->
    <ProjectReference Include="../../../presentation/Presentation.Common.csproj" />
  </ItemGroup>

</Project>
