{
  "formatVersion": 4,
  "meta": {
    "scriptId": "feel_x_latency_fps30",
    "scriptVersion": 1,
    "description": "同 feel_x_latency，表现帧率上限 30（一帧两个固定步）：帧量化让部分输入的可见时刻晚一个固定步，多出的一截仍须小于一个表现帧步长。",
    "datasetRoot": "data/_lab",
    "presetId": "",
    "calibrationVersion": "none",
    "poseSet": "none",
    "tickRate": 60,
    "frameRateCap": 30,
    "durationTicks": 200,
    "playerStart": {
      "x": 0,
      "y": 0
    },
    "dummyGroups": [
      "stake"
    ],
    "feel": true,
    "dummySet": "lab.dummy_set.lab_action",
    "learnSkills": [],
    "skillSlots": {
      "lab_a.attack": "skill.lab_a_slash",
      "lab_a.dodge": "skill.lab_a_dodge",
      "lab_a.skill": "skill.lab_a_bolt"
    },
    "scene": "",
    "feelCalibrationId": "",
    "extraDataRoots": [
      "data/_feel",
      "data/_lab_action"
    ],
    "extraDataExcludeTables": [],
    "extraDataExcludeRows": [],
    "weaponAttackSkills": {},
    "unarmedAttackSkill": "",
    "extraMetrics": [
      "latency",
      "crowd"
    ]
  },
  "events": [
    {
      "tick": 5,
      "action": "input.action.lab_a_attack",
      "kind": "press"
    },
    {
      "tick": 6,
      "action": "input.action.lab_a_attack",
      "kind": "release"
    },
    {
      "tick": 70,
      "action": "input.action.lab_a_skill",
      "kind": "press"
    },
    {
      "tick": 71,
      "action": "input.action.lab_a_skill",
      "kind": "release"
    },
    {
      "tick": 130,
      "action": "input.action.lab_a_dodge",
      "kind": "press"
    },
    {
      "tick": 131,
      "action": "input.action.lab_a_dodge",
      "kind": "release"
    }
  ],
  "expectations": [
    {
      "id": "visible_excess_nonneg",
      "cells": [
        "2d_action",
        "2_5d_action",
        "3d_action"
      ],
      "metric": "latency.visible_excess_ms_min",
      "op": "ge",
      "value": 0,
      "note": "首次可见时刻不早于逻辑必经时间（响应所在 tick 结束）"
    },
    {
      "id": "visible_excess_lt_frame",
      "cells": [
        "2d_action",
        "2_5d_action",
        "3d_action"
      ],
      "metric": "latency.visible_excess_ms_max",
      "op": "lt",
      "versus": {
        "metric": "latency.frame_ms"
      },
      "note": "帧量化多出的一截小于一个表现帧步长（随帧率上限变化，不写死数）"
    },
    {
      "id": "every_input_responds",
      "cells": [
        "2d_action",
        "2_5d_action",
        "3d_action"
      ],
      "metric": "latency.by_class",
      "op": "contains",
      "value": "attack:1:1",
      "note": "动作式格子里每类输入都有响应"
    }
  ]
}
