      "tolerance": 0.005,
      "note": "x=6.5 处的双线性插值高度（0.6 与 0.3 的中点）。"
    },
    {
      "id": "passes_the_hump",
      "cells": [
        "side_2d_targeted",
        "side_2d_action",
