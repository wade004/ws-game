{
  "formatVersion": 4,
  "meta": {
    "scriptId": "space.nav_detour",
    "scriptVersion": 1,
    "description": "空间扩展·寻路绕台阶（M4-W1a，ADR-0130 追加决定\"寻路感知台阶\"）：x 6..10、y -3..3 有一块高 2 的平台（台阶高度 0.5，爬不上去）。玩家在 (2,0) 点击移动到平台另一侧的 (14,0)：直线被台阶挡住，寻路绕到平台侧面之外再回到 y=0；全程没有被台阶截断（TerrainBlocked）、没有寻路失败。",
    "datasetRoot": "data/_lab",
    "presetId": "",
    "calibrationVersion": "none",
    "poseSet": "none",
    "tickRate": 60,
    "frameRateCap": 60,
    "durationTicks": 420,
    "playerStart": {
      "x": 2,
      "y": 0
    },
    "dummyGroups": [],
    "feel": true,
    "dummySet": "lab.dummy_set.lab_space_ext",
    "learnSkills": [],
    "skillSlots": {},
    "spaceExt": {
      "stepHeight": 0.5,
      "terrain": true,
      "arena": "lab.arena.lab_nav_steps"
    },
    "scene": "",
    "feelCalibrationId": "",
    "extraDataRoots": [
      "data/_feel",
      "data/_lab_action",
      "lab/fixtures/data/space_ext"
    ],
    "extraDataExcludeTables": [],
    "extraDataExcludeRows": [],
    "weaponAttackSkills": {},
    "unarmedAttackSkill": ""
  },
  "events": [
    {
      "tick": 0,
      "action": "input.action.lab_move_to",
      "kind": "move_to",
      "value": {
        "x": 14,
        "y": 0
      }
    }
  ],
  "expectations": [
    {
      "id": "arrives_behind_the_step",
      "cells": [
        "side_2d_targeted",
        "side_2d_action",
        "volume_targeted",
        "volume_action"
      ],
      "metric": "space_nav.arrived",
      "op": "eq",
      "value": 1,
      "note": "绕过去，到达目标。"
    },
    {
      "id": "never_blocked_by_the_step",
      "cells": [
        "side_2d_targeted",
        "side_2d_action",
        "volume_targeted",
        "volume_action"
      ],
      "metric": "space_nav.terrain_blocked_stops",
      "op": "eq",
      "value": 0,
      "note": "规划时就绕开台阶，不是走到台阶前才被截断。"
    },
    {
      "id": "path_found",
      "cells": [
        "side_2d_targeted",
        "side_2d_action",
        "volume_targeted",
        "volume_action"
      ],
      "metric": "space_nav.move_failed",
      "op": "eq",
      "value": 0,
      "note": "寻路成功。"
    },
    {
      "id": "walks_around_the_platform",
      "cells": [
        "side_2d_targeted",
        "side_2d_action",
        "volume_targeted",
        "volume_action"
      ],
      "metric": "space_nav.max_abs_y",
      "op": "gt",
      "value": 3,
      "note": "绕行：走到平台侧面（|y| > 3）之外。"
    },
    {
      "id": "detour_is_longer_than_straight",
      "cells": [
        "side_2d_targeted",
        "side_2d_action",
        "volume_targeted",
        "volume_action"
      ],
      "metric": "space_nav.detour_ratio",
      "op": "gt",
      "value": 1,
      "note": "走过的路程大于直线距离。"
    },
    {
      "id": "returns_to_the_axis",
      "cells": [
        "side_2d_targeted",
        "side_2d_action",
        "volume_targeted",
        "volume_action"
      ],
      "metric": "space_nav.final_y",
      "op": "approx",
      "value": 0,
      "tolerance": 0.02,
      "note": "回到 y=0 的目标点。"
    }
  ]
}
