      "value": 3,
      "tolerance": 1e-06,
      "note": "从台地高度（3）开始下落。"
    },
    {
      "id": "lands_on_the_ground",
      "cells": [
        "side_2d_targeted",
        "side_2d_action",
        "volume_targeted",
        "volume_action"
      ],
      "metric": "space_ext.landing_heights",
      "at": 0,
      "op": "approx",
      "value": 0,
      "tolerance": 1e-06,
      "note": "落到地面。"
    },
    {
      "id": "was_airborne",
      "cells": [
        "side_2d_targeted",
        "side_2d_action",
        "volume_targeted",
        "volume_action"
