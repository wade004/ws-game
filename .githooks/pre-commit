#!/bin/sh
# 提交前钩子（工程收尾 K 新增，2026-09-22 加入按暂存改动分级，见仓库根 README.md「提交前钩子」
# 一节）。
#
# 判断记录（为什么是版本化目录 .githooks/ 而不是 .git/hooks/）：.git/hooks/ 不受版本控制，换一台
# 机器或换一个协作者克隆本仓库都不会自带钩子；.githooks/ 提交进仓库本身，配合
# toolchain/install_hooks.ps1 把 git 的 core.hooksPath 指向这里，做到"钩子内容跟着仓库走"。
#
# 判断记录（为什么是 POSIX sh 而不是 PowerShell 脚本本身）：git 在 Windows 上（Git for Windows）
# 调用钩子固定经由随附的 Git Bash（sh.exe）执行，钩子文件本身必须是一个 POSIX shell 脚本，不能
# 直接把 .ps1 当钩子文件放。
#
# 找仓库根：钩子被 git 调用时的当前工作目录就是仓库根（不是 .git/ 或 .githooks/），直接用相对
# 路径 check.ps1 即可；显式 cd 到 git 报告的顶层目录只是防御性写法，防止未来钩子被从子目录触发
# 的某些 git 版本/前端在调用约定上有出入。
#
# 判断记录（第九轮审计工具链条目，2026-09-08）：非全量档情况下会跳过 toolchain 自身 pytest 套件
# （见 check.ps1 .PARAMETER Quick 说明）；这里仍统一导出 PYTHONUTF8=1，与
# .github/workflows/ci.yml 的作业级 PYTHONUTF8/PYTHONIOENCODING、check.ps1 非 -Quick 分支下
# pytest 步骤自己设置的同名环境变量保持一致——本钩子调用的 check.ps1 内部还会拉起
# validate_data.py/gen_event_constants.py 等多个 Python 子进程，统一导出可避免这些脚本任何一处
# 打印非 ASCII 文本时，在本机默认非 UTF-8 控制台代码页下出问题。
#
# 判断记录（按暂存改动分级，2026-09-22 提交前钩子分级任务；2026-10-01 改由定向门禁统一判级，
# ADR-0126）：一轮发布里主会话有 4～5 次提交，其中 CHANGELOG 定版/答复稿/回归记录只改文档，
# build.ps1 -Release 全量门禁通过后做的"发布 X.Y.Z"提交只改版本文件——这两类每次都再跑一遍
# check.ps1 -SkipUnity -Quick 是重复验证。现在的分派只有两步：
#   1) ReleaseSkip（唯一仍由 toolchain/precommit_tier.ps1 判定的档位）：build.ps1 -Release 在
#      "-Release 第 6 步"设置 WS_GAME_RELEASE_COMMIT=1 后再 git commit，且暂存清单确实只含该脚本
#      git add 的那几个版本文件——全量门禁已经在这次提交之前跑过（第 5 步），不重复跑，不用
#      --no-verify（那样会绕过钩子本身，事后不可追溯；这里是钩子内部按判定结果主动放行，仍会
#      打印说明）。分级纯函数见 toolchain/_precommit_tiering_guard.ps1，由
#      toolchain/tests/test_precommit_tiering_guard.py 覆盖。
#      MergeSkip（发布提速，2026-10-05，ADR-0156；同由 toolchain/precommit_tier.ps1 判定）：合并提交（MERGE_HEAD 恰有
#      一个）且即将提交的树与第二父提交的树逐字节相同、该第二父提交在 REGRESSION_LOG.md 有"含 Unity 全量通过"记录背书
#      （规则与理由见 toolchain/_precommit_tiering_guard.ps1 的 Get-PreCommitMergeSkip）——被提交的内容就是测过的内容，
#      不重复跑；主线上有分支没包含的独立改动被合进来时树不同，照常跑。1.99.0 的合并提交本可因此省掉约 20 分钟。
#   （2026-10-01 耗时自动记录：三处 check.ps1 调用都带 -NoTiming——钩子里的运行不写 timing/，否则每次提交
#   都会弄脏工作树；耗时只记任务里手动/显式跑的门禁。）
#   2) 其余一切情况（含合并提交——MERGE_HEAD 存在时同样只按暂存清单判定，不特殊放行）：跑
#      check.ps1 -Staged -SkipUnity，由 toolchain/change_impact.py 按暂存路径统一判级（T0～T3，
#      规则与步骤触发表见 toolchain/module_map.json）。此前的 DocsOnly 档就是现在的 T0（暂存改动全
#      是文档，只跑同一组文档相关步骤，含禁用词扫描——CLAUDE.md 硬性规则的唯一守门，任何档位都不能
#      跳过）；T1/T2 只跑命中层的测试工程与触发的步骤；T3（共享面/未知路径）此前叫 Full，
#      为保持"提交前只做秒级快速把关"的既有口径，这一档额外带 -Quick（与旧 Full 档完全相同：
#      check.ps1 -SkipUnity -Quick），完整全量仍由里程碑/手工 check.ps1 承担。
# 暂存清单为空（如空提交）、判级脚本调用失败（python/powershell 不可用、输出不是 T0～T3）一律退回
# 旧 Full 档（-SkipUnity -Quick，不走定向），不静默放行——"档位识别失败"不等于"可以跳过验证"。
set -e

export PYTHONUTF8=1

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_files=$(git diff --cached --name-only)

release_commit_env=""
if [ -n "$WS_GAME_RELEASE_COMMIT" ]; then
    release_commit_env="$WS_GAME_RELEASE_COMMIT"
fi

decision=""
if command -v powershell.exe >/dev/null 2>&1; then
    decision=$(printf '%s\n' "$staged_files" | WS_GAME_RELEASE_COMMIT="$release_commit_env" powershell.exe -NoProfile -ExecutionPolicy Bypass -File toolchain/precommit_tier.ps1 2>/dev/null | tr -d '\r' || true)
fi

tier=$(printf '%s' "$decision" | cut -d'|' -f1)
reason=$(printf '%s' "$decision" | cut -d'|' -f2-)

if [ "$tier" = "ReleaseSkip" ] || [ "$tier" = "MergeSkip" ]; then
    echo "[pre-commit] 档位：$tier（$reason）——不重复跑 check.ps1。"
    status=0
else
    level=""
    if [ -n "$staged_files" ] && command -v python >/dev/null 2>&1; then
        level=$(python toolchain/change_impact.py --staged --print-level 2>/dev/null | tr -d '\r' || true)
    fi
    case "$level" in
        T0|T1|T2)
            echo "[pre-commit] 定向门禁：暂存改动判为 $level——跑 check.ps1 -Staged -SkipUnity（只跑命中的步骤，全文日志落盘）..."
            powershell.exe -NoProfile -ExecutionPolicy Bypass -File check.ps1 -Staged -SkipUnity -NoTiming
            status=$?
            ;;
        T3)
            echo "[pre-commit] 定向门禁：暂存改动判为 T3（共享面/未知路径）——跑 check.ps1 -Staged -SkipUnity -Quick（与旧 Full 档相同的快速全量）..."
            powershell.exe -NoProfile -ExecutionPolicy Bypass -File check.ps1 -Staged -SkipUnity -Quick -NoTiming
            status=$?
            ;;
        *)
            echo "[pre-commit] 未取到可识别的定向级别（暂存清单为空，或判级脚本不可用；原始输出：$level），按最保守的旧 Full 档处理。"
            echo "[pre-commit] 跑 check.ps1 -SkipUnity -Quick..."
            powershell.exe -NoProfile -ExecutionPolicy Bypass -File check.ps1 -SkipUnity -Quick -NoTiming
            status=$?
            ;;
    esac
fi

if [ "$status" -ne 0 ]; then
    echo "[pre-commit] 门禁未通过（退出码 $status），提交已拦截。"
    echo "[pre-commit] 紧急情况可用 'git commit --no-verify' 跳过（不建议常态化使用）。"
    exit 1
fi

echo "[pre-commit] 通过。"
exit 0
