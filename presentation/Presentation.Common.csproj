<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Presentation.Common</AssemblyName>
    <RootNamespace>Presentation.Common</RootNamespace>
    <!-- 判断记录（P4-1 补充）：presentation/ 下每个 L5 模块都有自己的 .csproj（Presentation.ViewBinding/
         Presentation.Render/Presentation.Camera/……），但本文件位于 presentation/ 根目录，SDK 默认
         Compile glob 会递归纳入整个 presentation/ 子树（含其它模块目录，以及并行开发中的
         shell/vfx_sfx/ui 等），既会把本不属于 Presentation.Common 的类型编进本程序集，又会在引用了
         多个模块程序集的下游项目（如 Tests.PresentationCommon）里造成同名类型二义性。关闭默认隐式
         glob，改为下方显式 Include，把本程序集严格限定为 presentation/ 根目录下的散装文件（如
         LayerMarker.cs）与 presentation/common/ 子树，不随意扩大范围。 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="common/**/*.cs" Exclude="common/tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../core/gameplay/Core.Gameplay.csproj" />
  </ItemGroup>

</Project>
