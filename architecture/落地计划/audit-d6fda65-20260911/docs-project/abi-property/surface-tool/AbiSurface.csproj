<Project Sdk="Microsoft.NET.Sdk">
  <!--
    通用"公开 API 表面差异"门禁工具（PJ114-02 根治，外部审计 audit-76d16a5-20260910）：
    toolchain/abi_probe.ps1 此前只覆盖 toolchain/abi_probe/Program.cs 里手写死的少量签名（一次
    SkillHost 18 参数构造函数新增就漏判，见 PJ114-01），本工程用
    System.Reflection.MetadataLoadContext 反射整份 DLL 的公开/受保护 API 表面，与基线快照逐行比较，
    不再依赖人工维护的调用点。

    判断记录（为什么不用 <ProjectReference>/<Reference> 引用本仓库的 core/ 源码或 DLL）：本工程只是
    一个独立于被检查程序集的反射宿主，运行期把任意路径的 DLL（基线 zip 解出的旧版本、当前工作树
    刚构建出的新版本）都当作纯数据加载（MetadataLoadContext 不执行被加载程序集的任何代码），因此
    不需要、也不应该对 core/ 有编译期依赖——否则两次 dump（基线/当前）就会被同一份编译期引用绑死，
    反而测不出"物理签名是否变化"。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>AbiSurface</AssemblyName>
    <RootNamespace>Toolchain.AbiSurface</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 判断记录：仓库根 Directory.Build.props 对全仓库统一钉死
         <LangVersion>9.0</LangVersion>（core/* 类库发布目标是 netstandard2.1，需要保持较低语言
         版本），本工程是独立于 core/* 的 net8.0 命令行工具（见上方判断记录），不受该发布面约束，
         同 toolchain/abi_probe/AbiProbeConsumer.csproj 一样只覆盖 TargetFramework 是不够的——
         ImplicitUsings 生成的全局 using 指令（AbiSurface.GlobalUsings.g.cs）需要 C# 10 才能编译，
         这里显式覆盖 LangVersion。 -->
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>
</Project>
