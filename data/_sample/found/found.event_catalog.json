{
  "table": "found.event_catalog",
  "schema_version": 1,
  "rows": [
    { "key": "skill.cast_start", "domain": "skill", "fields": ["casterId", "skillId", "castTime"], "description": "施法管线步骤 8 开始（见 06 第 8 节）" },
    { "key": "skill.cast_success", "domain": "skill", "fields": ["casterId", "skillId", "targets"], "description": "施法管线步骤 9 完成（见 06 第 8 节）" },
    { "key": "skill.cast_failed", "domain": "skill", "fields": ["casterId", "skillId", "reasonCode"], "description": "施法管线任一步骤失败（见 06 第 8 节）" },
    { "key": "skill.cast_interrupted", "domain": "skill", "fields": ["casterId", "skillId", "interrupterId"], "description": "读条/引导被打断（见 06 第 8 节）" },
    { "key": "combat.damage_dealt", "domain": "combat", "fields": ["sourceId", "targetId", "school", "amount", "isCrit", "hitResult"], "description": "结算管线\"落地\"步骤，伤害类效果（见 06 第 8 节）" },
    { "key": "combat.heal_done", "domain": "combat", "fields": ["sourceId", "targetId", "amount", "isCrit"], "description": "结算管线\"落地\"步骤，治疗类效果（见 06 第 8 节）" },
    { "key": "aura.applied", "domain": "aura", "fields": ["targetId", "auraDefId", "sourceId", "stacks"], "description": "apply_aura 生效（见 06 第 8 节）" },
    { "key": "aura.removed", "domain": "aura", "fields": ["targetId", "auraDefId", "reason"], "description": "光环到期/驱散/覆盖移除（见 06 第 8 节）" },
    { "key": "aura.stack_changed", "domain": "aura", "fields": ["targetId", "auraDefId", "oldStacks", "newStacks"], "description": "叠加层数变化（见 06 第 8 节）" },
    { "key": "proc.triggered", "domain": "skill", "fields": ["unitId", "procDefId", "triggerSkillId"], "description": "Proc 命中触发条件；domain 为 skill（06 第 8 节原文如此，不等于 key 首段 proc）" },
    { "key": "combat.threat_changed", "domain": "combat", "fields": ["unitId", "sourceId", "oldValue", "newValue"], "description": "仇恨表更新（见 06 第 8 节）" },
    { "key": "combat.entered", "domain": "combat", "fields": ["unitId"], "description": "进入战斗（见 06 第 8 节）" },
    { "key": "combat.left", "domain": "combat", "fields": ["unitId"], "description": "脱离战斗（见 06 第 8 节）" },
    { "key": "unit.died", "domain": "unit", "fields": ["unitId", "killerId"], "description": "死亡结算完成（见 06 第 8 节）" },
    { "key": "unit.respawned", "domain": "unit", "fields": ["unitId", "policy"], "description": "按死亡复活策略处理完成（见 06 第 8 节）" },
    { "key": "stat.changed", "domain": "stat", "fields": ["unitId", "stat", "oldValue", "newValue"], "description": "属性最终值变化（见 06 第 1、8 节）" },
    { "key": "power.changed", "domain": "power", "fields": ["unitId", "powerType", "oldValue", "newValue"], "description": "资源值变化（见 06 第 2、8 节）" },
    { "key": "ai.state_changed", "domain": "ai", "fields": ["unitId", "oldState", "newState"], "description": "行为外壳状态机切换（见 06 第 6、8 节）" },
    { "key": "sim.turn_started", "domain": "sim", "fields": ["actorId", "roundIndex"], "description": "离散模式下 TurnScheduler 切到某行动者时触发（见 06 第 8 节）" },
    { "key": "sim.turn_ended", "domain": "sim", "fields": ["actorId"], "description": "离散模式下某行动者的回合结束时触发（见 06 第 8 节）" },
    { "key": "sim.round_ended", "domain": "sim", "fields": ["roundIndex"], "description": "离散模式下一轮全部行动者结束时触发（见 06 第 8 节）" },
    { "key": "sim.awaiting_input", "domain": "sim", "fields": ["actorId"], "description": "离散模式下轮到玩家行动、调度器暂无步产出时触发（见 06 第 8 节）" },
    { "key": "app.state_changed", "domain": "app", "fields": ["oldState", "newState"], "description": "应用级状态机状态迁移完成（见 01 模块表 app_lifecycle 行、03 第 1、2 节 AppStateHost.onStateChanged）；字段为建议值" },
    { "key": "sim.tick_started", "domain": "sim", "fields": ["tickIndex"], "description": "WorldSim.tick 开始处理本次 SimStep 时触发（见 01 模块表 sim_loop 行、03 第 4.2 节）；字段为建议值" },
    { "key": "sim.tick_finished", "domain": "sim", "fields": ["tickIndex"], "description": "WorldSim.tick 完成八步处理后触发（见 01 模块表 sim_loop 行、03 第 4.2 节）；字段为建议值" },
    { "key": "data.load_completed", "domain": "data", "fields": ["tableCount"], "description": "DataRegistry 完成一批数据表加载后触发（见 01 模块表 data_registry 行）；字段为建议值" },
    { "key": "data.validation_failed", "domain": "data", "fields": ["errorCount"], "description": "DataRegistry 校验发现错误时触发（见 01 模块表 data_registry 行、04 第 5 节校验器）；字段为建议值" },
    { "key": "save.completed", "domain": "save", "fields": ["slotId"], "description": "存档写入完成（见 01 模块表 save_system 行）；字段为建议值" },
    { "key": "save.loaded", "domain": "save", "fields": ["slotId"], "description": "存档读取完成（见 01 模块表 save_system 行）；字段为建议值" },
    { "key": "save.migrated", "domain": "save", "fields": ["slotId", "fromVersion", "toVersion"], "description": "存档版本迁移完成（见 01 模块表 save_system 行）；字段为建议值" },
    { "key": "input.action_triggered", "domain": "input", "fields": ["actionName"], "description": "物理输入经 InputMap 转译出的游戏动作被触发（见 01 模块表 input_map 行、03 第 7 节）；字段为建议值" },
    { "key": "input.rebind_conflict", "domain": "input", "fields": ["actionName", "binding"], "description": "重绑定检测到冲突（见 01 模块表 input_map 行、03 第 7 节）；字段为建议值" },
    { "key": "l10n.language_changed", "domain": "l10n", "fields": ["locale"], "description": "L10nHost.setLocale 切换语言完成（见 01 模块表 localization 行、03 第 9 节 L10nHost）；字段为建议值" },
    { "key": "display_info.reloaded", "domain": "display_info", "fields": [], "description": "DisplayInfoRegistry 底层数据重新加载完成（见 01 模块表 display_info 行）；不携带字段，字段为建议值" },
    { "key": "scene.load_started", "domain": "scene", "fields": ["sceneId"], "description": "SceneRouter.loadScene 开始加载（见 01 模块表 scene_router 行、03 第 6 节场景路由流程步骤 1）；字段为建议值" },
    { "key": "scene.load_finished", "domain": "scene", "fields": ["sceneId"], "description": "场景加载与初始化完成，应用状态机转入 InWorld（见 01 模块表 scene_router 行、03 第 6 节场景路由流程步骤 6）；字段为建议值" },
    { "key": "scene.unloaded", "domain": "scene", "fields": ["sceneId"], "description": "旧场景的 WorldSim 集合与全部 View 卸载完成（见 01 模块表 scene_router 行、03 第 6 节场景路由流程步骤 4）；字段为建议值" },
    { "key": "hook.invoked", "domain": "hook", "fields": ["hookId"], "description": "HookRegistry.invoke 被调用（调试用，见 01 模块表 hook_registry 行）；字段为建议值" },
    { "key": "entity.created", "domain": "entity", "fields": ["entityId", "kind", "displayId"], "description": "WorldSim 把新逻辑对象加入集合时触发，供 ViewBinder 创建 View（见 03 第 5 节逻辑对象与 View 的绑定协议）" },
    { "key": "entity.destroyed", "domain": "entity", "fields": ["entityId"], "description": "WorldSim 生命周期清理阶段真正移除某实体前触发，供 ViewBinder 销毁 View（见 03 第 5 节、第 4.2 节 tick 步骤 8）" },
    { "key": "presentation.playback_finished", "domain": "presentation", "fields": [], "description": "表现层回放队列清空后触发，解除 wait_for_playback 节奏门（见 03 第 8、9 节 PacingPolicy.onPlaybackFinished、09 第 6.4 节）；表现层唯一允许发出并被 L0 消费的事件，不携带字段" }
  ]
}
